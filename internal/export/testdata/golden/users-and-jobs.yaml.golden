#!/usr/bin/env bash
set -euo pipefail
#
# Generated by tack export test
# Playbook:   users-and-jobs.yaml
# Host:       db01
# WARNING: facts not gathered; fact references may be unresolved
#
# This is a SNAPSHOT. Re-export if playbook, inventory, or target facts change.
#
TACK_CHANGED=0
TACK_FAILED=0
TACK_CURRENT_TASK=""
on_exit() {
  local ec=$?
  if [[ $ec -ne 0 ]]; then
    echo "tack-export: FAILED on task: ${TACK_CURRENT_TASK}" >&2
  fi
  echo "tack-export: summary: changed=${TACK_CHANGED} failed=${TACK_FAILED}" >&2
  exit $ec
}
trap on_exit EXIT


# === TASK: Ensure ops group ===
TACK_CURRENT_TASK='Ensure ops group'
if ! getent group 'ops' >/dev/null 2>&1; then
  groupadd -r 'ops'
  TACK_CHANGED=$((TACK_CHANGED+1))
else
fi


# === TASK: Create admin users === (tags: users)
TACK_CURRENT_TASK='Create admin users'
if ! getent passwd 'alice' >/dev/null 2>&1; then
  useradd -s '/bin/bash' -G 'ops' 'alice'
  TACK_CHANGED=$((TACK_CHANGED+1))
else
  usermod -s '/bin/bash' -aG 'ops' 'alice'
  TACK_CHANGED=$((TACK_CHANGED+1))
fi


# === TASK: Create admin users === (tags: users)
TACK_CURRENT_TASK='Create admin users'
if ! getent passwd 'bob' >/dev/null 2>&1; then
  useradd -s '/bin/bash' -G 'ops' 'bob'
  TACK_CHANGED=$((TACK_CHANGED+1))
else
  usermod -s '/bin/bash' -aG 'ops' 'bob'
  TACK_CHANGED=$((TACK_CHANGED+1))
fi


# === TASK: Nightly backup job === (tags: cron)
TACK_CURRENT_TASK='Nightly backup job'
_tack_cron=$(crontab -l 2>/dev/null || true)
if echo "$_tack_cron" | grep -qF '# Tack: nightly-backup'; then
  echo "$_tack_cron" | awk -v marker='# Tack: nightly-backup' -v entry='30 2 * * * /usr/local/bin/backup.sh' '
    $0 == marker { print; getline; print entry; next }
    { print }
  ' | crontab -
else
  { echo "$_tack_cron"; echo '# Tack: nightly-backup'; echo '30 2 * * * /usr/local/bin/backup.sh'; } | crontab -
fi
TACK_CHANGED=$((TACK_CHANGED+1))

