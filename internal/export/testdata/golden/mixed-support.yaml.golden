#!/usr/bin/env bash
set -euo pipefail
#
# Generated by tack export test
# Playbook:   mixed-support.yaml
# Host:       app01
# WARNING: facts not gathered; fact references may be unresolved
#
# This is a SNAPSHOT. Re-export if playbook, inventory, or target facts change.
#
TACK_CHANGED=0
TACK_FAILED=0
TACK_CURRENT_TASK=""
on_exit() {
  local ec=$?
  if [[ $ec -ne 0 ]]; then
    echo "tack-export: FAILED on task: ${TACK_CURRENT_TASK}" >&2
  fi
  echo "tack-export: summary: changed=${TACK_CHANGED} failed=${TACK_FAILED}" >&2
  exit $ec
}
trap on_exit EXIT


# === TASK: Clone the app repo === (tags: deploy)
TACK_CURRENT_TASK='Clone the app repo'
if [ ! -e '/opt/app/.git' ]; then
  mkdir -p '/opt'
  git clone --branch 'main' 'https://example.com/app.git' '/opt/app'
  TACK_CHANGED=$((TACK_CHANGED+1))
else
  _tack_head=$(git -C '/opt/app' rev-parse HEAD)
  _tack_want=$(git -C '/opt/app' rev-parse 'main' 2>/dev/null || echo 'unknown')
  if [ "$_tack_head" != "$_tack_want" ]; then
    git -C '/opt/app' fetch origin
    git -C '/opt/app' checkout --detach 'main'
    TACK_CHANGED=$((TACK_CHANGED+1))
  fi
fi


# === TASK: Ensure a config line === (tags: config)
TACK_CURRENT_TASK='Ensure a config line'
if ! grep -qF 'mode=production' '/etc/app.conf' 2>/dev/null; then
  echo 'mode=production' >> '/etc/app.conf'
fi
TACK_CHANGED=$((TACK_CHANGED+1))


# === TASK: Wait for the database (unsupported) ===
# UNSUPPORTED: module does not support export
# Original task YAML:
#   module: wait_for
#   name: Wait for the database (unsupported)
#   params:
#       host: db01
#       port: 5432
#   tags:
#       - deploy


# === TASK: Run a command === (tags: deploy)
TACK_CURRENT_TASK='Run a command'
/opt/app/bin/migrate
TACK_CHANGED=$((TACK_CHANGED+1))

